# ─── Сервис ───────────────────────────────────────────────────────────────────
# AI_HOST=127.0.0.1
# AI_PORT=8100
# Разрешённые источники запросов из браузера, через запятую.
# AI_CORS_ORIGIN=*
# Файл базы SQLite. Относительный путь отсчитывается от каталога services/ai.
# AI_DATABASE_PATH=data/ai.db

# Провайдеры и модели заводят в справочниках запросами POST /api/providers и
# POST /api/models. При запуске сервис дозаполняет справочники сам:
# - каталог AI_BOOTSTRAP_DIR: файл yandex.env с ключами YANDEX_* как в env-файле xip
#   заводит провайдера yandex и модель AI_DEFAULT_MODEL; файл mcp.json — подключения MCP;
# - AI_BOOTSTRAP_MCP: подключения MCP в формате MCP-клиентов, JSON-текстом.
# Существующие записи не перезаписываются.
# AI_BOOTSTRAP_DIR=../../../data
# AI_DEFAULT_MODEL=qwen3.6-35b-a3b/latest
# AI_BOOTSTRAP_MCP={"mcpServers": {"platform": {"url": "http://localhost:8000/mcp/"}}}

# ─── Поведение агента ─────────────────────────────────────────────────────────
# AGENT_MAX_STEPS=10
# AGENT_TEMPERATURE=0.3
# AGENT_MAX_TOKENS=
# TOOL_RESULT_MAX_CHARS=8000

# ─── Подключения MCP ──────────────────────────────────────────────────────────
# Первый предел покрывает подключение и запрос перечня инструментов, второй — один вызов.
# MCP_CONNECT_TIMEOUT_MS=30000
# MCP_CALL_TIMEOUT_MS=60000
# Пороги предупреждения об объёме набора инструментов. Набор при этом не сокращается.
# MCP_WARN_TOOL_COUNT=60
# MCP_WARN_SCHEMA_CHARS=60000

# ─── Трассировка ──────────────────────────────────────────────────────────────
# Пусто — трассировка не отправляется. Phoenix запускается локально на порту 6006.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006
# OTEL_SERVICE_NAME=hackneft-ai
# OTEL_CAPTURE_CONTENT=true
