# ─── Сервис ───────────────────────────────────────────────────────────────────
# AGGREGATOR_HOST=127.0.0.1
# AGGREGATOR_PORT=8200

# ─── Источники ────────────────────────────────────────────────────────────────
# Каталог с CSV источников. Пакет данных лежит вне репозитория, поэтому путь задаётся
# настройкой. Относительный путь отсчитывается от services/aggregator.
# Ожидаемые файлы:
#   avt_tags.csv, 242000_tags.csv — телеметрия (широкий формат);
#   lims_tags.csv, pack_tags.csv — ЛИМС и ПАК после `hackneft-convert-quality`.
# AGGREGATOR_SOURCE_DIR=data

# ─── Темп симуляции ───────────────────────────────────────────────────────────
# Начальное положение курсора. Действует при первом запуске и при сбросе курсора;
# дальше курсор берётся из сохранённого состояния.
# AGGREGATOR_START_DATE=2023-01-01T00:00:00
# Интервал опроса: реальное время между тактами отправки, в минутах.
# AGGREGATOR_INTERVAL_MINUTES=10
# Шаг курсора: модельное время, на которое курсор продвигается за такт, в минутах.
# Отношение шага к интервалу — коэффициент ускорения симуляции.
# AGGREGATOR_STEP_MINUTES=10
# Первичная закачка: сколько часов истории отправить сразу после запуска, если курсор стоит
# в начальном положении. Ноль — закачки нет.
# AGGREGATOR_PRELOAD_HOURS=0
# Задержка готовности результата ЛИМС после отбора пробы, в минутах. Показание ЛИМС
# отправляется, когда курсор проходит момент «отбор + задержка», с отметкой времени отбора.
# По спецификации данных результат появляется в течение 4 часов.
# AGGREGATOR_LIMS_DELAY_MINUTES=240
# Предельное число записей в одном запросе к платформе.
# AGGREGATOR_BATCH_LIMIT=500
# Файл с сохранённым положением курсора.
# AGGREGATOR_STATE_PATH=data/cursor.json

# ─── Платформа ────────────────────────────────────────────────────────────────
# PLATFORM_URL=http://localhost:8000
# AGGREGATOR_REQUEST_TIMEOUT_MS=10000
