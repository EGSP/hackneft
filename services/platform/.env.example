# Файл базы SQLite. Относительный путь отсчитывается от каталога services/platform.
# PLATFORM_DATABASE_PATH=data/platform.db

# Адрес ИИ-сервиса. По нему работает общий работник советника, и через него платформа
# передаёт запросы страницы «Сессии» (ai_sessions.py). Без ИИ-сервиса приём и выдача
# показаний работают, а страница сессий сообщает о его недоступности.
# AI_SERVICE_URL=http://localhost:8100

# Агрегатор: на время работы советника платформа включает у него темп реального времени.
# AGGREGATOR_URL=http://localhost:8200

# Один запуск на установку за интервал: от 15 до 60 минут, по умолчанию 30.
# ADVISOR_INTERVAL_MINUTES=30

# replay: время окна агрегатора; пауза воспроизведения не старит данные.
# live: местные часы сервера; пропажа потока обнаруживается по таймеру.
# ADVISOR_CLOCK=replay

# Необязательный идентификатор настроенного агента ИИ-сервиса.
# Без него используется модель по умолчанию и задача со снимком и причинами.
# ADVISOR_AGENT_ID=
