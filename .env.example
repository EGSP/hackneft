# Переменные для docker compose (compose.yaml), не для самих сервисов — те настраиваются
# своими файлами services/*/.env.example.
#
# Скопировать в .env и указать путь к папке с файлами телеметрии (avt_tags.csv,
# 242000_tags.csv) на этом компьютере. Она пробрасывается агрегатору томом только для
# чтения. Если не задавать переменную — используется каталог data на уровень выше
# корня репозитория.
HACKNEFT_DATA_DIR=../data
